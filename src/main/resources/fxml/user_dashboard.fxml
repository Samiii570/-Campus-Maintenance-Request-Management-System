<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650" prefWidth="1000" style="-fx-background-color:#EEF7F5;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">


    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color:#2E7D6B; -fx-padding:15;">
            <Label style="-fx-text-fill:white;" text="Campus Maintenance Request Management System">
                <font>
                    <Font size="18" />
                </font>
            </Label>
            <Pane HBox.hgrow="ALWAYS" />
            <Label style="-fx-text-fill:white;" text="Welcome, User" />
            <Button text="Logout" />
        </HBox>
    </top>


    <left>
        <VBox prefWidth="200" spacing="12" style="-fx-background-color:#DFF2EE; -fx-padding:15;">
         <Label text="User Dashboard">
            <font>
               <Font name="System Bold" size="14.0" />
            </font>
         </Label>
            <Label text="MENU">
                <font>
                    <Font size="14" />
                </font>
            </Label>
            <Button text="Profile" />
            <Button text="New Request" />
            <Button text="My Requests" />
        </VBox>
    </left>


    <center>
        <VBox spacing="20" style="-fx-padding:20;">


            <HBox spacing="15">

                <VBox prefWidth="200" spacing="5" style="-fx-background-color:#C8E6C9; -fx-padding:15; -fx-background-radius:12;">
                    <Label text="Total Requests" />
                    <Label text="0">
                        <font>
                            <Font size="26" />
                        </font>
                    </Label>
                </VBox>

                <VBox prefWidth="200" spacing="5" style="-fx-background-color:#FFF9C4; -fx-padding:15; -fx-background-radius:12;">
                    <Label text="Pending" />
                    <Label text="0">
                        <font>
                            <Font size="26" />
                        </font>
                    </Label>
                </VBox>

                <VBox prefWidth="200" spacing="5" style="-fx-background-color:#BBDEFB; -fx-padding:15; -fx-background-radius:12;">
                    <Label text="In Progress" />
                    <Label text="0">
                        <font>
                            <Font size="26" />
                        </font>
                    </Label>
                </VBox>

                <VBox prefWidth="200" spacing="5" style="-fx-background-color:#E1BEE7; -fx-padding:15; -fx-background-radius:12;">
                    <Label text="Completed" />
                    <Label text="0">
                        <font>
                            <Font size="26" />
                        </font>
                    </Label>
                </VBox>

            </HBox>

            <VBox spacing="10">
                <Label text="Recent Maintenance Requests">
                    <font>
                        <Font size="16" />
                    </font>
                </Label>

                <TableView prefHeight="350">
                    <columns>
                        <TableColumn prefWidth="120" text="Request ID" />
                        <TableColumn prefWidth="150" text="Category" />
                        <TableColumn prefWidth="200" text="Location" />
                        <TableColumn prefWidth="150" text="Status" />
                        <TableColumn prefWidth="150" text="Date" />
                    </columns>
                </TableView>
            </VBox>

        </VBox>
    </center>

</BorderPane>
