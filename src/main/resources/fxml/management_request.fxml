<BorderPane prefHeight="600" prefWidth="900" style="-fx-background-color:#EEF7F5;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">

    <!-- TOP intentionally empty -->

    <center>
        <AnchorPane>
            <children>
                <VBox alignment="CENTER" spacing="20" AnchorPane.leftAnchor="40" AnchorPane.rightAnchor="40" AnchorPane.topAnchor="40">

                    <Label text="Manage Maintenance Requests" textFill="#03638f">
                        <font><Font name="System Bold" size="18.0" /></font>
                    </Label>

                    <TableView prefHeight="254.0" prefWidth="820.0" style="-fx-background-color:white;                                       -fx-background-radius:12;">
                        <columns>
                            <TableColumn prefWidth="126.66665267944336" text="Request ID" />
                            <TableColumn prefWidth="110.66668701171875" text="User" />
                            <TableColumn prefWidth="124.0" text="Location" />
                            <TableColumn prefWidth="117.33334350585938" text="Issue" />
                            <TableColumn prefWidth="342.6666259765625" text="Status" />
                        </columns>
                    </TableView>
                </VBox>

                 <Button layoutX="367.0" layoutY="356.0" prefWidth="220" style="-fx-background-color:#2E7D6B;                                    -fx-text-fill:white;                                    -fx-background-radius:10;" text="Update Selected Request" />
            </children>
        </AnchorPane>
    </center>
   <top>
      <HBox prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <ImageView fitHeight="163.0" fitWidth="189.0">
               <image>
                  <Image url="@../../../../../../Desktop/logo%20-%20Copy.png" />
               </image>
            </ImageView>
            <Label alignment="CENTER" prefHeight="182.0" prefWidth="711.0" text="Campus Maintenance Request Management System">
               <font>
                  <Font name="System Bold" size="23.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </top>
</BorderPane>
